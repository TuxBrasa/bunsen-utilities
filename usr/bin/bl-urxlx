# https://github.com/BunsenLabs/bunsen-utilities


# Internationalize the bl-urxlx script

TEXTDOMAIN="bl-urxlx"
TEXTDOMAINDIR="/usr/share/locale"

export TEXTDOMAIN TEXTDOMAINDIR


if ! command -v yad &> /dev/null; then

  echo -e "\nThe yad program is not installed.\n"

  exit 1

fi

logo="/usr/share/icons/Bunsen-lightdm/256x256/status/avatar-default.png"

which gettext        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The gettext program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


# help

help() {

    local HELP

    HELP="$(gettext "
    bl-urxlx is a naive Xresources to Lxterminal color config converter

Options:

    -h --help   show this message

Examples:

    urxlx .Xresources > tmp.txt

    urxlx monokai.txt | xclip
")"

    printf '%s\n' "$HELP"
}


if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then

    help

    exit

fi

# ffffff to rgb(255,255,255)

2rgb() {
    hex="$1"
    printf "rgb(%d,%d,%d)\n" 0x"${hex:0:2}" 0x"${hex:2:2}" 0x"${hex:4:2}"

}

# main

for file in "$@" ; do
    echo # empty line
    grep -E --color=never 'color[0-9]|background:|foreground:' "$file" | while read -r color hex; do

        if [[ $color =~ [!0-9] ]]; then

            # printf "\n$(gettext "%s has number")\n" "$color"

            color="palette_color_${color//[!0-9]}"

        else
            [[ $color == *"background"* ]] && color="bgcolor"
            [[ $color == *"foreground"* ]] && color="fgcolor"
        fi

        hex="${hex//#}" # remove #

        echo "$color=$(2rgb "$hex")"

    done
done

