# https://github.com/BunsenLabs/bunsen-utilities


# Internationalize the xml2xfconf script

TEXTDOMAIN="xml2xfconf"
TEXTDOMAINDIR="/usr/share/locale"

export TEXTDOMAIN TEXTDOMAINDIR


if ! command -v yad &> /dev/null; then

  echo -e "\nThe yad program is not installed.\n"

  exit 1

fi

logo="/usr/share/icons/Bunsen-lightdm/256x256/status/avatar-default.png"

which gettext        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The gettext program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }




for cmd in xmlstarlet; do

    if ! command -v "${cmd}" >/dev/null 2>&1; then
        yad \
            --center \
            --window-icon "$logo" \
            --image=dialog-error \
            --timeout=10 \
            --no-buttons \
            --title "$(gettext "Warning")" \
            --text "$(printf '%s\n' \
                "$(gettext "The following required program is not installed: ")
" \
                "${cmd}")" \
            --width="450" \
            --height="100" \
            2>/dev/null

        exit 1
    fi

done


# shellcheck disable=SC2016
HELP="$(gettext 'xml2xfconf: convert xfce xfconf xml file entries into xfconf-query commands

SUMMARY:    xml2xfconf -x|--xml-file <filepath> [-c|--channel <channelname>]

Passed an xfce xfconf xml file, this script will print
the necessary xfconf-query commands to update
the xfconf database for that channel.

If passed a channel name, that will be compared with
the channel name defined in the xml,
and if they are different the script will exit.

This is expected to be useful when restoring the xfconf settings of
an app whose xml file has been backed up.

USAGE EXAMPLE:

restore=$(mktemp);
xml2xfconf -x /path/to/xfce4-terminal.xml -c xfce4-terminal > "$restore";
bash "$restore"
')"

while [[ -n $1 ]]
do
    case "$1" in
    -h|--help)
        echo "$HELP"
        exit 0
        ;;
    -x|--xml-file)
        XML=$2
        shift 2
        ;;
    -c|--channel)
        chk_channel=$2
        shift 2
        ;;
    *)

        printf "$(gettext "%s: %s: no such option")" "${0}" "${1}" >&2

        echo "$HELP"

        exit 1
        ;;
    esac
done

if ! hash xmlstarlet >/dev/null 2>&1; then

    printf "$(gettext "%s: xmlstarlet not found; install it first.")" "${0}" >&2

    exit 1
fi

if [[ -z "$XML" ]] ; then

    printf "$(gettext "%s: missing -x|--xml-file option")" "${0}" >&2

    echo "$HELP"

    exit 1
fi

if [[ ! -f "$XML" ]]; then

    printf "$(gettext "%s: %s file not found")" "${0}" "$XML" >&2

    exit 1
fi

# Parse channel name from XML <channel name="...">

channel=$(xmlstarlet sel -t -v "/channel/@name" "$XML" 2>/dev/null)

if [[ -z "$channel" ]]; then

    printf "$(gettext "%s: Could not parse channel name from %s")" "${0}" "$XML" >&2

    exit 1
fi

[[ -n $chk_channel ]] && [[ $chk_channel != "$channel" ]] && {

    printf "$(gettext "%s: Passed channel name %s does not match %s in the xml file")" "${0}" "$chk_channel" "$channel" >&2

    exit 1
}

# Each <property> element may represent:
#  - a leaf value (string/bool/int/double)
#  - an array of <value> elements
#  - a subtree of nested <property> children
#
# This function walks the tree recursively and prints xfconf-query commands.

walk_properties() {
    local xpath="$1"
    local base_path="$2"

    xmlstarlet sel -t \
        -m "$xpath/property" \
        -v "concat(@name,'|',@type)" -n \
        "$XML" 2>/dev/null | while IFS='|' read -r name type; do

        local prop_path
        if [[ -z "$base_path" ]]; then
            prop_path="/$name"
        else
            prop_path="$base_path/$name"
        fi

        # Counts

        local child_count
        child_count=$(xmlstarlet sel -t \
            -v "count($xpath/property[@name='$name']/property)" \
            "$XML" 2>/dev/null)

        local value_count
        value_count=$(xmlstarlet sel -t \
            -v "count($xpath/property[@name='$name']/value)" \
            "$XML" 2>/dev/null)

        # If this node is explicitly an array, treat it as such even if it has child <property> nodes

        if [[ "$type" = "array" ]] || [[ "$value_count" != "0" && "$child_count" = "0" ]]; then

            # Collect all types & values

            typevalues=()
            while IFS= read -r tv; do
                typevalues+=("$tv")
            done < <(xmlstarlet sel -t \
                -m "$xpath/property[@name='$name']/value" \
                -v "concat(@type,'|',@value)" -n \
                "$XML" 2>/dev/null)

            local qtype
            printf 'xfconf-query -c %q -p %q -n -a' \
                "$channel" "$prop_path"
            for tv in "${typevalues[@]}"; do
                qtype=${tv%|*}; value=${tv#*|}
                [[ -z "$qtype" ]] && qtype="string"  # Safe default for arrays without <value @type>
                printf ' -t %s -s %q' "$qtype" "$value"
            done
            printf '\n'

           # CRITICAL: Always recurse into child properties after printing array

            if [[ "$child_count" != "0" ]]; then
                walk_properties "$xpath/property[@name='$name']" "$prop_path"
            fi
            
        elif [[ "$child_count" != "0" ]]; then

            # Recurse into subtree (non-array case)

            walk_properties "$xpath/property[@name='$name']" "$prop_path"

        else
            # Scalar leaf: use @value

            local value
            value=$(xmlstarlet sel -t \
                -m "$xpath/property[@name='$name']" \
                -v "@value" \
                "$XML" 2>/dev/null)

            # Map XML type to xfconf-query type

            local qtype
            case "$type" in
                string|int|bool|double|uint) qtype="$type" ;;
                empty) continue ;;  # Skip empty properties entirely
                *) qtype="$type" ;;
            esac

            printf 'xfconf-query -c %q -p %q -n -t %s -s %q\n' \
                "$channel" "$prop_path" "$qtype" "$value"
        fi
    done
}

# Start at the root <channel> element

walk_properties "/channel" ""

