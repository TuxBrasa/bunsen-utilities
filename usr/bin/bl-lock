#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#    You should have received a copy of the GNU General Public License
#    along with this program.  If not, see <http://www.gnu.org/licenses/>.



# https://github.com/BunsenLabs/bunsen-utilities


# Internationalize the bl-lock script

TEXTDOMAIN="bl-lock"
TEXTDOMAINDIR="/usr/share/locale"

export TEXTDOMAIN TEXTDOMAINDIR

clear

logo="/usr/share/icons/Bunsen-lightdm/256x256/status/avatar-default.png"

which gettext        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The gettext program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


which bl-exit        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The bl-exit program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


LOCK_COMMAND=(bl-exit --lock)
# wayland testing will now be handled by bl-exit
#[[ -n "$WAYLAND_DISPLAY" ]] && LOCK_COMMAND=(gtklock -d)


HELP="$(gettext '
bl-lock is a wrapper for the configured screenlock command

Usage:  bl-lock
   or:  bl-lock -h|--help

Optional arguments:

    -h | --help    Show this message (no other options are supported)

If running in live mode, offer up a prompt detailing the live session password.
Else, run '%s'
')"


# look for a help option somewhere

for i in "$@"
do
    case "$i" in
    -h|--help)
        printf "$HELP\n" "${LOCK_COMMAND[*]}"

        exit 0

        ;;
    esac
done


which ${LOCK_COMMAND[0]} >/dev/null 2>&1 || {

    printf "$(gettext "%s: %s no such command.")" "$0" "${LOCK_COMMAND[0]}" >&2

    exit 1
}


# if [[ -d /lib/live && ! -f $HOME/.config/bunsen/bl-lock ]]; then

if grep -q '\<boot=live\>' /proc/cmdline && [[ ! -e $HOME/.config/bunsen/bl-lock ]]; then

    yad --center --image='bunsenlabs' --window-icon='distributor-logo-bunsenlabs' --borders=20 --fixed --on-top --title="$(gettext "Lock screen info:")" --text="$(gettext 'Lock screen has detected you are running a live session.
The username needed to unlock the screen is "user" and the password is "live".
This notice will only be displayed once per live session.')" --button="$(gettext "OK")"

    mkdir -p "$HOME/.config/bunsen"
    touch "$HOME/.config/bunsen/bl-lock"

fi

"${LOCK_COMMAND[@]}"

exit 0

