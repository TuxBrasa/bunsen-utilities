# https://github.com/BunsenLabs/bunsen-utilities


# Internationalize the bl-conkymove script

TEXTDOMAIN="bl-conkymove"
TEXTDOMAINDIR="/usr/share/locale"

export TEXTDOMAIN TEXTDOMAINDIR



if ! command -v yad &> /dev/null; then

  echo -e "\nThe yad program is not installed.\n"

  exit 1

fi

logo="/usr/share/icons/Bunsen-lightdm/256x256/status/avatar-default.png"

which gettext        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The gettext program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


which conky        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "$(gettext "Warning")" \
--text "$(gettext "The conky program is not installed.")" \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


HELP="$(gettext "bl-conkymove is a script to set the position of a moveable Conky

Usage:  bl-conkymove
   or:  bl-conkymove -h|--help

Optional arguments:

    -h | --help    Show this message (no other options are supported)

After invoking the script, follow the displayed instructions
to move a selected conky to a new position on the screen.
")"

# look for a help option somewhere

for i in "$@"
do
    case "$i" in
    -h|--help)
        echo "$HELP"
        exit 0
        ;;
    esac
done

error_exit(){

    printf "$(gettext "%s error: %s")" "$0" "$1" >&2

    exit 1
}

## check necessary tools are installed

required_commands=(xwininfo xprop yad) # array, space-separated words

missing_commands=()
for i in "${required_commands[@]}"
do
    hash $i || missing_commands+=(" $i")
done
[[ ${missing_commands[0]} ]] && error_exit "$(printf "$(gettext "This script requires the following commands: %s
Please install the packages containing the missing commands
and rerun the script.")" "${missing_commands[*]}")"

BL_COMMON_LIBDIR='/usr/lib/bunsen/common'

if ! . "$BL_COMMON_LIBDIR/yad-includes" 2> /dev/null; then

    printf '%s\n' \
    "$(printf "$(gettext 'Error: Failed to locate yad-includes in %s')" "$BL_COMMON_LIBDIR")" >&2

    exit 1
fi

#####FUNCTIONS#####

# makes array "config"

parse_conkyfile(){
    [[ -f $1 ]] || { printf "$(gettext "%s is not a file.")" "$1" >&2;return 1;}
    unset config
    declare -Ag config
    local line parse=false comment=false conkyconf name value
    while read -r line
    do
        if [[ $line =~ ^[[:blank:]]*'--[[' ]]
        then
            comment=true # ignore comment blocks
            continue
        else
            line=${line%%--*} # remove inline comments
        fi
        if [[ $comment = true ]]
        then
            if [[ $line = *']]'* ]]
            then
                comment=false
                line=${line#*]]}
            else
                continue
            fi
        fi
        [[ $line ]] || continue
        if [[ $line =~ ^[[:blank:]]*'conky.config'[[:blank:]]*(=[[:blank:]]*'{'(.*))?$ ]]
        then
            parse=true
            conkyconf=${BASH_REMATCH[2]}
            continue
        fi
        if [[ $parse = true ]]
        then
            if [[ $line =~ ([^}]*)'}' ]]
            then
                conkyconf+=${BASH_REMATCH[1]}
                break
            else
                conkyconf+=$line
            fi
        fi
    done < "$1"
    entry_regex="([[:alnum:]_]+)[[:blank:]]*=[[:blank:]]*([[:alnum:]-]+|'[^']+'|\"[^\"]+\")"
    while [[ $conkyconf =~ $entry_regex ]]
    do
        name=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]#[\'\"]} # strip quotes
        value=${value%[\'\"]}
        config["${name}"]="${value}"
        conkyconf=${conkyconf#*${BASH_REMATCH[0]}}
    done
}

# for version 1.09 conky files
# makes array "config"

parse_conkyfile_1.09(){
    [[ -f $1 ]] || { printf "\n$(gettext "%s is not a file.")\n" "$1" >&2;return 1;}
    unset config
    declare -Ag config
    local name value
    while read -r name value
    do
        [[ $name ]] || continue
        [[ $name = TEXT* ]] && break
        config["$name"]="$value"
    done < <(sed 's/\#.*$//' "$1")
}


# usage: edit_conkyfile file name=value [name2=value2...]
# parse_conkyfile should already have been run

edit_conkyfile(){
    file=$1
    shift
    local name value sed_pattern sed_replace
    declare -a sed_args
    while [[ $1 ]]; do
        unset name value sed_pattern sed_replace
        name="${1%%=*}"
        value="${1#*=}"
        shift
        [[ ${config["$name"]+x} ]] || {

            printf "\n$(gettext "%s: config key %s does not exist")\n" "$0" "$name" >&2

            return 1
        }
        [[ ${config["$name"]} = "${value}" ]] && continue
        [[ $value =~ ^([0-9-]+|true|false)$ ]] || value=\'"$value"\' # add quotes
        (( ${#sed_args[@]} == 0 )) && sed_args=("-ri")
        sed_pattern="[[:blank:]]*${name}[[:blank:]]*=[[:blank:]]*([[:alnum:]-]+|'[^']+'|\"[^\"]+\")"
        grep -Eq -- "-- bl-conky(pin|move), original value for $name:" "$file" ||
            sed_replace="-- bl-conkymove, original value for $name: ${config[$name]}\n"
        sed_replace+="\t$name = $value"
        sed_args+=("-e")
        sed_args+=("s/$sed_pattern/$sed_replace/")
    done
   (( ${#sed_args[@]} )) && sed "${sed_args[@]}" "$file"
}

# for version 1.09 conky files
# usage: edit_conkyfile file name=value [name2=value2...]
# parse_conkyfile should already have been run

edit_conkyfile_1.09(){
    file=$1
    shift
    local name value
    declare -a sed_args
    while [[ $1 ]]; do
        unset name value sed_pattern sed_replace
        name="${1%%=*}"
        value="${1#*=}"
        shift
        [[ ${config["$name"]+x} ]] || {

            printf "\n$(gettext "%s: config key %s does not exist")\n" "$0" "$name" >&2

            return 1
        }
        [[ ${config["$name"]//[[:space:]]} = "${value//[[:space:]]}" ]] && continue
        (( ${#sed_args[@]} == 0 )) && sed_args=("-ri")
        sed_pattern="^ *$name .*$"
        grep -q "#conkymove, original value for $name:" "$file" ||
            sed_replace="#conkymove, original value for $name: ${config[$name]}\n"
        sed_replace+="$name $value"
        sed_args+=("-e")
        sed_args+=("s/$sed_pattern/$sed_replace/")
    done
    (( ${#sed_args[@]} )) && sed "${sed_args[@]}" "$file"
}

getStart(){    #   Get initial Conky position
    unset CONKYPATH
    unset info1
    declare -A info1
    while read -r line
    do
        unset key value
        [[ $line =~ Window\ id:[[:blank:]]*(0[xX][0-9a-fA-F]+) ]] && {
            ID=${BASH_REMATCH[1]}
        }
        [[ $line != xwininfo:* && $line = *:* ]] && {
            key=${line%:*}
            value=${line#*:}
            info1[$key]=$value
        }
    done < <(xwininfo)
    # info1 array now contains all the output of xwininfo

    wmc=$(xprop -id "$ID"  WM_COMMAND)
    wmc=${wmc#*\"} # strip first & last quotes & everything outside
    wmc=${wmc%\"*}
    CMD=${wmc%% *} # separate first word
    CMD=${CMD%\"*}
    CONKYPATH=$(awk -F '", "' '{
        for (i=1;i<=NF;i++){
            if ($i ~ /^-[a-zA-Z]*c$/) {
                i++
                gsub(/\\\"/,"\"",$i) # unescape quotes
                print $i
                exit
            }
            if ($i ~ /^--config/) {
                sub(/--config=/,"",$i)
                gsub(/\\\"/,"\"",$i)
                print $i
                exit
            }
        }
    }' <<< "$wmc")

    [[ -z "$CONKYPATH" ]] && CONKYPATH="$HOME/.config/conky/conky.conf"

    redo_dialog(){
        echo "$0: $1" >&2
        yad_error '--button='$(gettext "Exit")':1' "$(printf "$(gettext "%s

Choose again?")" "$1")"
        if (( $? == 1 ));then
            echo "  $(gettext "Cancelled: exiting...")"
            exit 0
        fi
        getStart
    }

    if [[ $CMD != conky ]];then
        redo_dialog "$(gettext "Selection is not a conky")"
    elif [[ $CONKYPATH != /* ]];then
        redo_dialog "$(printf "$(gettext "%s is not an absolute path.")" "$CONKYPATH")"
    else
        # echo "$(gettext "Found a conky")"
        posX_1=${info1[Absolute upper-left X]}
        posY_1=${info1[Absolute upper-left Y]}
    fi
}

getFinish(){   #   Get new Conky position
    unset info2
    declare -A info2
    while read -r line
    do
        unset key value
        [[ $line != xwininfo:* && $line = *:* ]] && {
            key=${line%:*}
            value=${line#*:}
            info2[$key]=$value
        }
    done < <(xwininfo -id "$ID")
    posX_2=${info2[Absolute upper-left X]}
    posY_2=${info2[Absolute upper-left Y]}
}

getOffset(){   # parse_conkyfile should already have been run
    if [[ ${config[alignment]} = none ]];then   # placement managed by Openbox

        yad_info "$(gettext "This Conky has 'alignment none'
so placement is handled by the Window Manager.
")"

        echo -e "\n$(gettext "Conky has 'alignment none',
so placement is handled by the Window Manager
Exiting...")"

        exit 0
    fi

    OFFSET_X=$(( posX_2 - posX_1 ))
    OFFSET_Y=$(( posY_2 - posY_1 ))

    case ${config[alignment]} in
        tr|top_right|mr|middle_right|br|bottom_right|mm|middle_middle|bm|bottom_middle|tm|top_middle)
            gapX=$(( ${config[gap_x]} - OFFSET_X ))
            ;;
        tl|top_left|ml|middle_left|bl|bottom_left)
            gapX=$(( ${config[gap_x]} + OFFSET_X ))
            ;;
    esac
    case ${config[alignment]} in
        tr|top_right|tl|top_left|tm|top_middle)
            gapY=$(( ${config[gap_y]} + OFFSET_Y ))
            ;;
        br|bottom_right|bl|bottom_left|bm|bottom_middle|mm|middle_middle|ml|middle_left|mr|middle_right)
            gapY=$(( ${config[gap_y]} - OFFSET_Y ))
            ;;
    esac
}

adjust_wintype() {
    [[ ${CONKYPATH:-X} = 'X' || ${config[own_window_type]:-normal} = 'normal' ]] && return 0
    original_wintype=${config[own_window_type]}
    edit_conkyfile "$CONKYPATH" "own_window_type=normal"
    config[own_window_type]=normal
}

restore_wintype() {
    [[ ${CONKYPATH:-X} = 'X' || ${original_wintype:-X} = 'X' ]] && return 0
    edit_conkyfile "$CONKYPATH" "own_window_type=$original_wintype"
}

cleanup() {
    if [[ $success = TRUE ]];then
        restore_wintype # backup file $BKP left, but will be overwritten on next run
    elif [[ -n $CONKYPATH && -f $BKP ]];then

        printf "$(gettext "%s: exit, restoring original %s")" "$0" "$CONKYPATH"

        mv "$BKP" "$CONKYPATH"
    else

        printf "$(gettext "%s: exit, nothing to restore")" "$0"

    fi
}

########################################################################

success=FALSE

unset CONKYPATH BKP config posX_1 posY_1 posX_2 posY_2 OFFSET_X OFFSET_Y gapX gapY

trap cleanup EXIT

# Conky in Debian Buster needs this workaround:
# reload conky config to work around a bug
# where conky seems to be part of root desktop window.
# https://forums.bunsenlabs.org/viewtopic.php?id=7111
# Not needed with conky 1.11.6-2 in Bullseye.
#pkill -USR1 -x conky

yad_question "$(gettext "To pick a conky, click 'Select Conky',

then click the 'xwininfo' cursor on the chosen conky
to record its position.")" \
     --button="$(gettext "Select Conky"):0" --button="$(gettext "Cancel"):1"

if (( $? == 0 ));then
    getStart
    BKP="${CONKYPATH}.bkp"
    cp "$CONKYPATH" "$BKP"
    if ! grep -Eq '(^|[[:blank:]])conky\.config[[:blank:]]*=?' "$CONKYPATH"
    then
        yad_info "$(gettext "This conky uses v1.09 syntax.
It is recommended to convert the conky to v1.10 syntax.
See: https://forums.bunsenlabs.org/viewtopic.php?id=3983")"
        parse_conkyfile() {
            parse_conkyfile_1.09 "$@"
        }
        edit_conkyfile() {
            edit_conkyfile_1.09 "$@"
        }
    fi
else

    echo "  $(gettext "Cancelled: exiting...")"

    exit 0
fi

parse_conkyfile "$CONKYPATH"

adjust_wintype

yad_question "$(gettext "Move the Conky to the desired location
with Alt+L-mousebutton Drag.

Then click 'OK' to record the new position.")" \
     --button="$(gettext "OK"):0" --button="$(gettext "Cancel"):1"

if (( $? == 0 ));then
    getFinish
else

    echo "  $(gettext "Cancelled: exiting...")"

    exit 0
fi

getOffset

edit_conkyfile "$CONKYPATH" "gap_x=$gapX" "gap_y=$gapY"

success=TRUE

exit

