#: bl-restart:57
msgid ""
"bl-restart is a script to restart all running instances of\n"
"any process name passed\n"
"\n"
"Usage: bl-restart <name>\n"
"   or: bl-restart -h|--help\n"
"\n"
"Optional arguments:\n"
"\n"
"    -h | --help  Show this message (no other options are supported at this "
"time)\n"
"\n"
"Each running process is stopped with SIGTERM.\n"
"\n"
"All previously running commands are then re-run, forked and disowned,\n"
"with any duplicates removed.\n"
msgstr ""
"bl-restart é um script para reiniciar todas as instâncias em execução de\n"
"qualquer nome de processo informado\n"
"\n"
"Uso: bl-restart <nome>\n"
"  ou: bl-restart -h|--help\n"
"\n"
"Argumentos opcionais:\n"
"\n"
"    -h | --help  Exibe esta mensagem (nenhuma outra opção é suportada no "
"momento)\n"
"\n"
"Cada processo em execução é interrompido com SIGTERM.\n"
"\n"
"Todos os comandos executados anteriormente são então reexecutados, em segundo plano (forked e disowned),\n"
"com as duplicatas removidas.\n"

#: bl-restart:92
msgid "%s: no %s processes running"
msgstr "%s: nenhum processo %s em execução"

#: bl-restart:101
msgid "%s: no %s processes found belonging to %s"
msgstr "%s: nenhum processo %s encontrado pertencente a %s"

#: bl-restart:105
msgid "%s: ERROR: failed to kill %s"
msgstr "%s: ERRO: falha ao encerrar %s"

#: bl-restart:113
msgid "%s: Some processes still running after %s, killing %s"
msgstr "%s: Alguns processos ainda estão em execução após %s, encerrando %s"

