#: bl-notify-broadcast:44
msgid "Warning"
msgstr "Aviso"

#: bl-notify-broadcast:46
msgid "The following required program is not installed: "
msgstr "O seguinte programa necessário não está instalado: "

#: bl-notify-broadcast:59
msgid ""
"Call notify-send for all current X users.\n"
"Passed arguments (message, icon etc) are sent on as-is.\n"
"This script must be run as root."
msgstr ""
"Chama o notify-send para todos os usuários X atuais.\n"
"Os argumentos passados (mensagem, ícone etc.) são repassados como estão.\n"
"Este script deve ser executado como root."

#: bl-notify-broadcast:74
msgid "%s error: %s"
msgstr "Erro em %s: %s"

#: bl-notify-broadcast:85
msgid ""
"This script requires the following commands: %s\n"
"Please install the packages containing the missing commands\n"
"and rerun the script."
msgstr ""
"Este script requer os seguintes comandos: %s\n"
"Por favor instale os pacotes contendo os comandos ausentes\n"
"e execute novamente o script."

#: bl-notify-broadcast:89
msgid "This script must be run as root."
msgstr "Este script deve ser executado como root."

