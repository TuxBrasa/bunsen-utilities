#: bl-xinerama-prop:61
msgid ""
"Using the current cursor position, print the dimensions of the monitor the "
"cursor is on, or the monitor name."
msgstr ""
"Usando a posição atual do cursor, exibe as dimensões do monitor onde o "
"cursor está localizado ou o nome do monitor."

#: bl-xinerama-prop:66
msgid "print debug information"
msgstr "exibe informações de depuração"

#: bl-xinerama-prop:67
msgid "print current monitor name instead of dimensions"
msgstr "exibe o nome do monitor atual em vez das dimensões"

#: bl-xinerama-prop:83
#, python-format
msgid "Failed to open X11 display %s - does it exist?"
msgstr "Falha ao abrir o display X11 %s - ele existe?"

#: bl-xinerama-prop:86
msgid "Failed to open GDK default display"
msgstr "Falha ao abrir o display padrão do GDK"

#: bl-xinerama-prop:87
#, python-format
msgid "Using display: %s"
msgstr "Usando o display: %s"

#: bl-xinerama-prop:95
msgid "No pointer device associated with display - none connected?"
msgstr "Nenhum dispositivo ponteiro associado ao display - nenhum conectado?"

#: bl-xinerama-prop:98
#, python-format
msgid "Using pointer device is: %s"
msgstr "Usando o dispositivo ponteiro: %s"

#: bl-xinerama-prop:102
#, python-format
msgid "Using monitor: %s (%s)"
msgstr "Usando o monitor: %s (%s)"

