#: bl-restart:57
msgid ""
"bl-restart is a script to restart all running instances of\n"
"any process name passed\n"
"\n"
"Usage: bl-restart <name>\n"
"   or: bl-restart -h|--help\n"
"\n"
"Optional arguments:\n"
"\n"
"    -h | --help  Show this message (no other options are supported at this "
"time)\n"
"\n"
"Each running process is stopped with SIGTERM.\n"
"\n"
"All previously running commands are then re-run, forked and disowned,\n"
"with any duplicates removed.\n"
msgstr ""

#: bl-restart:92
msgid "%s: no %s processes running"
msgstr ""

