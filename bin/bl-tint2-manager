#
#   Tint2 config files must be in $TINT2PATH
#
#   When the dialog opens, any running tint2s will be checkmarked.
#
#   Click "Apply" and all running tint2s are stopped,
#   and all checkmarked tint2s are started.
#
#   To stop a tint2 just uncheck it, and "Apply".
#
#   Running tint2s are saved to a session file, and can be run with
#   the "tint2-session" script. To start them at login, add the
#   following line to autostart:
#
#           bl-tint2-session
#
########################################################################



# https://github.com/BunsenLabs/bunsen-utilities


# Internationalize the bl-tint2-manager script

TEXTDOMAIN="bl-tint2-manager"
TEXTDOMAINDIR="/usr/share/locale"

export TEXTDOMAIN TEXTDOMAINDIR


if ! command -v yad &> /dev/null; then

  echo -e "\nThe yad program is not installed.\n"

  exit 1

fi

logo="/usr/share/icons/Bunsen-lightdm/256x256/status/avatar-default.png"

which gettext        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The gettext program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }




for cmd in tint2 killall; do

    if ! command -v "${cmd}" >/dev/null 2>&1; then
        yad \
            --center \
            --window-icon "$logo" \
            --image=dialog-error \
            --timeout=10 \
            --no-buttons \
            --title "$(gettext "Warning")" \
            --text "$(printf '%s\n' \
                "$(gettext "The following required program is not installed: ")
" \
                "${cmd}")" \
            --width="450" \
            --height="100" \
            2>/dev/null

        exit 1
    fi

done






TINT2PATH="$HOME/.config/tint2"
TINT2DEFAULT=$(readlink -f "${TINT2PATH}/tint2rc") # tint2rc is a symlink to this release's default tint2 file
SESSIONFILE="$TINT2PATH/tint2-sessionfile"

USAGE="$(gettext 'bl-tint2-manager is a tint2 selection and switcher script
which uses yad to generate a graphical user interface.

Usage:  bl-tint2-manager
   or:  bl-tint2-manager -h|--help

Optional arguments:

    -h | --help    Show this message (no other options are supported at this time)

Use:

    With no command option the script runs the gui

    Tint2 config files must be in HOME/.config/tint2/

    When the dialog opens, any running tint2s will be checkmarked.

    Click "Apply" and all running tint2s are stopped,
    and all checkmarked tint2s are started.

    To stop a tint2 just uncheck it, and click "Apply".

    Click "Apply" to return to the dialog after applying changes,
    click "Apply+Close" to close the window after applying changes,
    click "Close" to close the window without applying any more changes.

    Running tint2s are saved to a session file, and can be run with
    the "tint2-session" script. To start them at login, add the
    following line to autostart:

            bl-tint2-session
')"

# look for a help option somewhere, then exit

for i in "$@"
do
    case "$i" in
    -h|--help)
        echo "$USAGE"
        exit 0
        ;;
    esac
done

BL_COMMON_LIBDIR='/usr/lib/bunsen/common'

if ! . "$BL_COMMON_LIBDIR/bl-includes" 2> /dev/null; then

    printf '%s\n' \
    "$(printf "$(gettext 'Error: Failed to locate bl-includes in %s')" "$BL_COMMON_LIBDIR")" >&2

    exit 1
fi

# pangoEscape() for yad text display of filenames
# is provided in bl-includes

### DIALOG VARIABLES

DLG="yad --center --undecorated --borders=20 "
DLGDEC="yad --center --borders=20 "
TITLE="$(gettext "BunsenLabs Tint2 Manager")"
WINICON="--window-icon=distributor-logo-bunsenlabs"
OK="--button=$(gettext "OK"):0"
APPLY="--button=$(gettext "Apply"):0"
CLOSE="--button=$(gettext "Close"):1"


########## FUNCTIONS ###################################################

getRunning(){
    unset runningTints
    local pid command TPATH
    declare -g -A runningTints
    while read -r pid; do
        mapfile -d '' -t command < "/proc/${pid}/cmdline" # use NULL delimiter to split cmdline into array 'command'
        [[ ${command[0]} = 'tint2' ]]  || {

            printf "$(gettext "%s: pgrep parsing failed: command is not 'tint2'")" "$0" >&2

            continue
        }
        if (( ${#command[@]} > 1 )); then
            TPATH=${command[-1]} # tint2 takes no options other than -c, which is optional
            [[ $TPATH = /* ]] || TPATH="$HOME/$TPATH" # assume path is relative to $HOME
        else
            TPATH="$TINT2DEFAULT"
        fi
        [[ -f $TPATH ]] || {

            printf "$(gettext "%s: pgrep tint2 parsing failed: %s is not a file")" "$0" "$TPATH" >&2

            continue
        }
        runningTints["$TPATH"]=1
    done < <(pgrep -x 'tint2' -u "$USER")
}

# $1 should hold full path to config file
# returns 0 if a running tint2 is using that file

isRunning(){
    local file=$1
    [[ ${runningTints["$file"]} = 1 ]] && return 0
    return 1
}

findTints(){
    getRunning
    LISTTINT=() # global
    local file name check
    shopt -s globstar
    for file in "$TINT2PATH"/**;do
        [[ -f $file ]] || continue
        [[ $file = *~ ]] && continue # ignore backups
        grep -q "panel_monitor" "$file" || continue # not a tint2rc file
        name=${file#$TINT2PATH/}
        if isRunning "$file"; then
            check='TRUE'
        else
            check='FALSE'
        fi
        LISTTINT+=("$check" "$(pangoEscape "$name")" "$file")
    done
    shopt -u globstar
}

loadDialog() {

    local choice retval

    choice=$($DLGDEC $WINICON --list --title="$TITLE" \
        --text="$(gettext "Select Tint2s from the list:")" \
        --checklist --print-column=2 \
        --column="$(gettext "Select"):CHK" --column="$(gettext "tint2 Name"):TEXT" --column=$(gettext "path"):HD "${LISTTINT[@]}" \
        --separator='' --print-column=3 \
        $APPLY --button="$(gettext "Apply+Close")":2 $CLOSE \
        --width="400" --height="500" \
        )
    retval=$?
    if (( retval == 1 )); then # close button pressed
        exit 0
    fi
    if [[ -z $choice ]];then  # No tint2s chosen

        MSG="$(gettext "Nothing chosen.

Kill all running Tint2s?")"

        $DLG $WINICON --title="$TITLE" --text="$MSG" $OK --button="$(gettext "Try Again")":1

        if [[ $? = 1 ]];then
            return
        fi
    fi

    :> "$SESSIONFILE"    # Create/overwrite empty session file

    if pgrep -x -u "$USER" tint2 >/dev/null;then
        killall -u "$USER" tint2
        sleep 0.5 # make sure killed tint2s are not running at next iteration of getRunning()
    fi

    while read -r path
    do
        [[ -n $path ]] || continue
        echo "${path#$HOME/}" >> "$SESSIONFILE" # strip $HOME to avoid unnecessary warnings from bl-obthemes when restoring
        set -m # enable job control so forked tint2 is immune to signals

        # start the tint2 (adjust the sleep time if required)

        tint2 -c "$path" >/dev/null 2>&1 &
        disown
        set +m
        sleep 0.5s
    done <<< "$choice"

#   if there is a button that returns 2, it will apply changes and exit

    (( retval == 2 )) && exit 0
}

# get any commandline arguments (none expected)

if ! (( $# == 0 ));then
    for arg in "$@";do
        if [[ $1 = "-h" ]] || [[ $1 = "--help" ]];then

            echo -e "$USAGE"

            exit 0

        else

            printf "$(gettext "%s: ERROR: sorry I don't understand %s")" "$0" "\"${arg}\"" >&2

            echo -e "$USAGE"

            exit 1
        fi
    done
fi

while true;do
    findTints
    loadDialog
done

exit 0

