#!/usr/bin/env bash
#
# bl-image-upload: script to upload files to an image hosting service
# Taking of screenshots is also supported.
# Edit so that your chosen image upload script is uncommented.
# bl-imgbb-upload needs an account to be set up (the script helps).
# bl-imgur-upload allows anonymous uploads but does not serve the UK.
#
########################################################################

# https://github.com/BunsenLabs/bunsen-utilities


# Internationalize the bl-image-upload script

TEXTDOMAIN="bl-image-upload"
TEXTDOMAINDIR="/usr/share/locale"

export TEXTDOMAIN TEXTDOMAINDIR


uploader=bl-imgbb-upload
# uploader=bl-imgur-upload


logo="/usr/share/icons/Bunsen-lightdm/256x256/status/avatar-default.png"

which gettext        1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "Warning" \
--text "The gettext program is not installed." \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


which $uploader      1> /dev/null 2> /dev/null || { yad \
--center \
--window-icon "$logo" \
--image=dialog-error \
--timeout=10 \
--no-buttons \
--title "$(gettext "Warning")" \
--text "$(printf "$(gettext "The %s program is not installed.")" "$uploader")" \
--width="450" --height="100" \
2>/dev/null   ; exit ; }


hash $uploader 2>/dev/null || {

    printf "$(gettext "%s: %s is not available")" "$0" "$uploader" >&2

    exit 1
}

$uploader "$@"


